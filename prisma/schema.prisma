generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  tagline     String
  price       Int
  emoji       String
  ingredients String[]
  benefits    String[]
  active      Boolean  @default(true)
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique
  customerName  String
  // nomor WhatsApp format 628xxxxxxxxxx (identitas pelanggan)
  phone         String?
  note          String?
  total         Int
  // kolom lama, tidak dipakai lagi
  status        String      @default("MENUNGGU_PEMBAYARAN")
  // MENUNGGU | LUNAS
  paymentStatus String      @default("MENUNGGU")
  // BARU | DIPROSES | SIAP | SELESAI | BATAL
  prepStatus    String      @default("BARU")
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  items         OrderItem[]
  payments      Payment[]

  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  price   Int
  qty     Int
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  midtransOrderId String    @unique
  method          String    @default("QRIS")
  amount          Int
  // PENDING | PAID | EXPIRED | FAILED
  status          String    @default("PENDING")
  qrUrl           String?
  qrString        String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
}
